{
  "name": "infravel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build && npm run check:worker",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "notifications:retry": "node scripts/retry-notifications.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json *.jsonc .github docs README.md",
    "check:worker": "node scripts/check-worker-manifests.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@opennextjs/cloudflare": "1.20.12",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsonc-parser": "^3.3.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
